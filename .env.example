URLHAUS_AUTH_KEY=

# notify_impersonated (T-031) — SMTP target. Defaults to the T-060 Range
# (Mailpit, range/docker-compose.yml publishes 1025) when unset. Leave these
# pointed at the Range: this tool sends real mail, and CLAUDE.md trap #6
# ("Range mail server only") applies to it, not just file_abuse_report.
SMTP_HOST=
SMTP_PORT=

# file_abuse_report (T-033) — refuses to send unless the SMTP destination is
# loopback (the Range). Set to exactly 1 ONLY if you intend to mail a real
# registrar's abuse contact. CLAUDE.md trap #6: never during testing.
ALLOW_EXTERNAL_SMTP=

# correspondence_history (T-022) — Mailpit's HTTP API, not IMAP (Mailpit has
# no IMAP support at all, PLAN.md §6). Defaults to the T-060 Range
# (range/docker-compose.yml publishes 8025) when unset.
MAILPIT_URL=

# quarantine (T-030) — Mailpit's HTTP API base URL. Defaults to the T-060
# Range (range/docker-compose.yml publishes 8025) when unset.
# NOTE: this is the same value as MAILPIT_URL above under a different name —
# T-022 and T-030 each independently added their own var while the other's
# PR wasn't merged yet. Flagged, not unified here (out of scope for a merge
# sync); see PLAN.md §8.
MAILPIT_HTTP_BASE_URL=
