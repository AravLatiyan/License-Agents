URLHAUS_AUTH_KEY=

# notify_impersonated (T-031) — SMTP target. Defaults to the T-060 Range
# (Mailpit, range/docker-compose.yml publishes 1025) when unset. Leave these
# pointed at the Range: this tool sends real mail, and CLAUDE.md trap #6
# ("Range mail server only") applies to it, not just file_abuse_report.
SMTP_HOST=
SMTP_PORT=
